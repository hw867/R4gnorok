     <property name="styleSheet">
      <string notr="true">QPushButton {
    /* 强制图标在左，文字在右 */
    qproperty-layoutDirection: LeftToRight;
    /* 可选：调整图标和文字的间距，以及去掉按钮边框 */
    padding-left: 8px;
    padding-right: 8px;
    border: none;
    text-align: left;
}
QPushButton {
    background-color: #f5f5f5;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-family: &quot;楷体&quot;;
