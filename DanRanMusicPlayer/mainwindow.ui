        <property name="styleSheet">
         <string notr="true">QListWidget {
	background-color: rgb(245, 245, 245);

    border: none;
    border-radius: 12px;
    outline: 0;
    font-family: &quot;Microsoft YaHei&quot;, &quot;楷体&quot;, &quot;Segoe UI&quot;;
    font-size: 14px;
    padding: 8px 0px;
}

/* 项（Item）默认样式 */
QListWidget::item {
    background-color: transparent;
    color: black;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin: 2px 8px;
    border-radius: 8px;
}

/* 悬停效果 */
QListWidget::item:hover {
    background-color: #3a3e42;
    color: white;
    border-left: 4px solid #ff7e5e;
    padding-left: 12px;
}

/* 当前选中项（正在播放） */
QListWidget::item:selected {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff7e5e, stop:1 #feb47b);
    color: white;
    font-weight: bold;
    border-left: 4px solid #ffd966;
    padding-left: 12px;
}

/* 去掉焦点虚线框 */
QListWidget:focus {
    outline: none;
}

/* 滚动条美化（可选） */
QListWidget::scroll-bar:vertical {
    background: #1e2124;
    width: 10px;
    border-radius: 5px;
    margin: 2px;
}
QListWidget::scroll-bar:handle:vertical {
    background: #5a5e62;
    border-radius: 5px;
    min-height: 30px;
}
QListWidget::scroll-bar:handle:vertical:hover {
    background: #ff7e5e;
}
QListWidget::scroll-bar:add-line, QListWidget::scroll-bar:sub-line {
    height: 0px;
}</string>
        </property>
        <property name="selectionRectVisible">
         <bool>false</bool>
        </property>
       </widget>
      </widget>
     </item>
    </layout>
